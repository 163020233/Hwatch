import("//build/ohos.gni")
import("../../../../build/gn/config.gni")

ohos_source_set("vdec_api") {
    sources = [
        "source/vdec_v7.0/soc_vdec_api.c",
        "source/vdec_v7.0/decoder_store/hardware/vdec_decoder_hw.c",
        "source/vdec_v7.0/decoder_store/vdec_hal/vdec_hal.c",
        "source/vdec_v7.0/decoder_store/vdec_store.c",
        "source/vdec_v7.0/platform/osal/liteos/mpi_vdec_osal.c",
        "source/vdec_v7.0/platform/sdk/fbb/mpi_vdec_sdk.c",
        "source/vdec_v7.0/decoder_store/mjpeg/vdec_decoder_mjpeg.c",
        "source/vdec_v7.0/decoder_store/mjpeg/vdec_jpeg_hal.c",
    ]

    configs =
      [ "${sdk_cfg_path}:sdk_public_configs" ]

    configs += [":private"]

    cflags = [
        "-Werror=out-of-line-declaration",
        "-Werror=uninitialized",
        "-Werror=int-conversion",
        "-Werror=enum-conversion",
        "-Werror=long-long",
        "-Werror=unused-variable",
        "-Werror=unused-value",
        "-Werror=unused-function",
        "-Werror=unused-but-set-variable",
        "-Werror=sign-compare",
        "-Werror=unused-parameter",
        "-Werror=tautological-compare",
        "-Werror=bad-function-cast",
        "-Werror=incompatible-pointer-types",
        "-Werror=implicit-function-declaration",
    ]
}

config("private") {
    include_dirs = [
      "include",
      "source/vdec_v7.0",
      "source/vdec_v7.0/decoder_store",
      "source/vdec_v7.0/decoder_store/hardware",
      "source/vdec_v7.0/decoder_store/vdec_hal",
      "source/vdec_v7.0/platform/osal/liteos",
      "source/vdec_v7.0/platform/sdk/fbb",
      "source/vdec_v7.0/decoder_store/mjpeg",
    ]

    defines = [
        "EXT_VDEC_MJPEG_SUPPORT",
        "VDEC_PROC_SUPPORT",
        "VDEC_MAX_CHAN_NUM=3"
    ]
}
