config AT_SUPPORT_PLT
    bool
    prompt "platform at command"
    default n
    help
        This option means at support plt.

config AT_DEBUG_REGISTER_CCPRIV
    bool
    prompt "ccpriv at debug command"
    default n
    help
        This option means at support ccpriv.

config AT_SUPPORT_CMD_FORWARD
    bool
    prompt "at support send cmd string to other core"
    default n
    help
        This option means at support send cmd to other core.

config AT_CMD_MAX_LENGTH
    int
    prompt "The max length of AT command."
    default 128
    help
        This option means the length of at command.

if AT_SUPPORT_PLT
menu "Config AT CFBB"
    comment "Config AT CFBB"
    osource  "middleware/utils/at/at/Kconfig"
endmenu
endif