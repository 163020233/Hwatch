import("//test/xts/tools/lite/build/suite_lite.gni")

# ohos begin
# file_hal, Code normalization, LiteWearable product customization exemption xts
xts_utils_file_hal_path = ""

declare_args() {
  xts_utils_file_hal_path = "//test/xts/acts/commonlibrary_lite/file_hal"
}
# ohos end

hctest_suite("ActsUtilsFileTest") {
  suite_name = "acts"
  # ohos begin
  # file_hal, Code normalization, LiteWearable product customization exemption xts
  sources = [
    "${xts_utils_file_hal_path}/src/utils_file_func_test.c",
    "${xts_utils_file_hal_path}/src/utils_file_reli_test.c",
  ]

  include_dirs = [
    "${xts_utils_file_hal_path}/src",
    "//commonlibrary/utils_lite/include",
  ]
  # ohos end
  if (board_toolchain_type != "iccarm") {
    cflags = [ "-Wno-error" ]
  }
}
