config PWM_AON_USING_V150
    bool
    prompt "Using PWM AON V150."
    default n
    depends on DRIVER_SUPPORT_PWM_AON

config PWM_AON_USING_V151
    bool
    prompt "Using PWM AON V151."
    default n
    depends on DRIVER_SUPPORT_PWM_AON

config PWM_AON_USING_V152
    bool
    prompt "Using PWM AON V152."
    default n
    depends on DRIVER_SUPPORT_PWM_AON

config PWM_AON_PRELOAD
    bool
    prompt "Using PWM AON preload."
    default n
    depends on PWM_AON_USING_V151 || PWM_AON_USING_V152

config PWM_AON_GROUP_NUM
    int
    prompt "The number of groups in PWM AON."
    range 1 16
    default 6
    depends on DRIVER_SUPPORT_PWM_AON

config PWM_AON_CHANNEL_NUM
    int
    prompt "PWM AON channel number."
    default 6
    depends on DRIVER_SUPPORT_PWM_AON

config PWM_AON_SUPPORT_TIME_32BIT
    bool
    prompt "Support time 32bit."
    default n
    depends on PWM_AON_USING_V151 || PWM_AON_USING_V152

config PWM_AON_SUPPORT_CLOCK_ENABLE
    bool
    prompt "Support PWM AON clock enable."
    default n
    depends on PWM_AON_USING_V151 || PWM_AON_USING_V152

config PWM_AON_PERIODLOAD_FLAG_BIT
    bool
    prompt "Support PWM AON periodload flag."
    default n
    depends on PWM_AON_USING_V151

config PWM_AON_IP_VERSION_V151_PRO
    bool
    prompt "The pwm ip version support seamless PWM AON waveform adjustment using DMA."
    default y
    depends on PWM_AON_USING_V151 && DRIVER_SUPPORT_LPB
