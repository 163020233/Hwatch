        *(.text.hal_efuse .rodata.hal_efuse)
        *(.text.hal_watchdog .rodata.hal_watchdog)
        *(.text.hal_rtc_unified .rodata.hal_rtc_unified)
        *(.text.hal_ipc .rodata.hal_ipc)
        *(.text.hal_timer .rodata.hal_timer)
        *(.text.hal_tcxo .rodata.hal_tcxo)
        *(.text.hal_systick .rodata.hal_systick)
