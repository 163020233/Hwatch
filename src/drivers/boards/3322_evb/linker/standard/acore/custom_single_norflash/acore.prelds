        *(.text.pm_veto_porting .rodata.pm_veto_porting)
        *(.text.pm_sleep_porting .rodata.pm_sleep_porting)
        *pm_sleep_porting.a:lowpower*.o* (.text .text* .rodata .rodata* .srodata .srodata*)
        *(.text.pm_porting .rodata.pm_porting)
        *(.text.pm_fsm_porting .rodata.pm_fsm_porting)
        *(.text.nv_porting .rodata.nv_porting)
