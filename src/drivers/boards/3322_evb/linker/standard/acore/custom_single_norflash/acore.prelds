       *(.bss)
       *(.bss*)
       *(.sbss)
       *(.sbss*)
       *(COMMON)
       . = ALIGN(8);
       __psram_bss_end = .;
   } > PSRAM_HEAP_MEM
   __psram_bss_size = __psram_bss_end - __psram_bss_start;
#endif

    /* psram heap */
    .extend_heap (NOLOAD): ALIGN(8)
    {
        . = ALIGN(8);
        __extend_heap_start = .;
        g_extend_heap_begin = ABSOLUTE(.);
        g_extend_heap_size = (ORIGIN(PSRAM_HEAP_MEM) + ABSOLUTE(PSRAM_HEAP_LENGTH)) - g_extend_heap_begin;
    } > PSRAM_HEAP_MEM

    /* npu psram mempool */
    .psram_npu_heap (NOLOAD):
    {
        . = ALIGN(8);
        __psram_heap_start = .;
        g_psram_heap_begin = ABSOLUTE(.);
        g_psram_heap_size = (ORIGIN(PSRAM_NPU_HEAP) + LENGTH(PSRAM_NPU_HEAP)) - g_psram_heap_begin;
    } > PSRAM_NPU_HEAP

    /* Like Uninitialised data, but we don't want to 0 it. Stores backtrace among other things. */
    .preserve (NOLOAD): ALIGN(8)
    {
        . = ALIGN(8);
        KEEP(*(preserve))
    } > PRESERVE_SHARE_MEM

    .cputrace_mem (NOLOAD):
    {
        . = ALIGN(8);
        KEEP(*(cputrace_mem))
    } > CPUTRACE_RAM
}

