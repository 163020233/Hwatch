 * Copyright (c) 2021 HiSilicon (Shanghai) Technologies Co., Ltd.
******************************************************************************/

#include "memory_config.h"
OUTPUT_ARCH(riscv)
ENTRY(Reset_Handler)

/* FLASH sector size is 2K */
/* make this table consistent with the configuration given by the security core */
MEMORY
{
    PROGRAM             : ORIGIN = LOADERBOOT_PROGRAM_ORIGIN,  LENGTH = LOADERBOOT_PROGRAM_LENGTH

    DTCM                : ORIGIN = LOADERBOOT_DATA_ORIGIN,     LENGTH = LOADERBOOT_DATA_LENGTH
    ROMBOOT_INFO_RAM    : ORIGIN = ROMBOOT_INFO_REGION_START,  LENGTH = ROMBOOT_INFO_REGION_LENGTH
}

SECTIONS
{
    /* Vectors */
    startup :
    {
        KEEP (*(.text.entry))
    } > PROGRAM

    /* Code and const data */
    .text :
    {
        . = ALIGN(64);
        KEEP (*(.text.trap_excp))
        . = ALIGN(64);
        KEEP (*(.text.trap_vector))
        . = ALIGN(64);
        KEEP (*(.isr_vector))
        *(.text)
        *(.text*)
        *(.rodata)
        *(.rodata*)
        *(.srodata)
        *(.srodata*)
        KEEP (*(.gdb_debug))
        . = ALIGN(8);
    } > PROGRAM

    __program_size__ =.;

    .stacks (NOLOAD): ALIGN(16)
    {
        g_system_stack_begin = .;
        . += LOADER_USER_STACK_LEN;
        __stack_top__ = .;
        . += LOADER_IRQ_STACK_LEN;
        __irq_stack_top__ = .;
        . += LOADER_EXCP_STACK_LEN;
        __excp_stack_top__ = .;
        . += LOADER_NMI_STACK_LEN;
        __nmi_stack_top__ = .;
        g_system_stack_end = .;
    } > DTCM
    g_system_stack_size = g_system_stack_end - g_system_stack_begin;
    g_stack_system = g_system_stack_size;

    /* Code relocated into RAM */
    .ramtext :
    {
        . = ALIGN(8);
        *(.ramtext)
        *(.ramtext*)
        KEEP (*(.flashtext))
        KEEP (*(.flashtext*))
        . = ALIGN(8);
        __ramtext_end__ = .;
    } > PROGRAM

    /* Initialised data */
    .data :
    {
        FILL(0xFF)
        __data_load__ = LOADADDR(.data);
        __data_begin__ = .;
        *(.data)
        *(.data*)
        *(.got)
        *(.got*)
        *(.igot)
        *(.igot*)
        _gp_ = . + 0x800;
        *(.sdata)
        *(.sdata*)
        __data_end__ = .;
        . = ALIGN(8);
    } > DTCM AT > PROGRAM
    __data_size__ = __data_end__ - __data_begin__;
    __global_pointer$ = _gp_;


    /* Uninitialised data */
    .bss (NOLOAD) :
    {
        . = ALIGN(8);
        __bss_begin__ = .;
        *(.bss)
        *(.bss*)
        *(.sbss)
        *(.sbss*)
        *(COMMON)
        . = ALIGN(8);
        __bss_end__ = . ;
    } > DTCM
    __bss_size__ = __bss_end__ - __bss_begin__;

    /* Like Uninitialised data, but we don't want to 0 it. Stores system clocks among other things. */

    .preserve (NOLOAD):
    {
        . = ALIGN(8);
        *(preserve)
    } > DTCM
    .uart_arg (NOLOAD):
    {
        . = ALIGN(4);
        __boot_uart_begin__ = .;
        *(BOOT_UART)
        . = ALIGN(4);
        __boot_uart_end__ = .;
    } > DTCM

    .romboot_info (NOLOAD):
    {
        . = ALIGN(8);
        *(romboot_info)
    } > ROMBOOT_INFO_RAM
}

/* Check actual number of flash pages used matches the expected number */
/* ASSERT(__FLASH_REGION_PAGES__ >= SSB_FLASH_REGION_PAGES, "Flash region pages is smaller than SSB_FLASH_REGION_PAGES" ); */
/* ASSERT(__FLASH_REGION_PAGES__ <= SSB_FLASH_REGION_PAGES, "Flash region pages is larger than SSB_FLASH_REGION_PAGES" ); */
