    bool
    prompt "support timeout in uart RX poll mode."
    default n
    depends on UART_SUPPORT_RX

config UART_SUPPORT_RX_THREAD_STACK_SIZE
    int
    prompt "UART RX thread stack size."
    default 1024
    depends on UART_SUPPORT_RX_THREAD

