# 新增配置项，用于控制是否使用自定义的管脚配置文件
config USE_CUSTOM_PIN_CONFIG
    bool
    prompt "Use custom pin configuration file."
    default n

if USE_CUSTOM_PIN_CONFIG
    config UART_BUS0_TX_PIN
        int
        prompt "UART config uart BUS0 tx pin."
        default 19
        depends on DRIVER_SUPPORT_UART && (UART_BUS_MAX_NUM > 0)

    config UART_BUS0_RX_PIN
        int
        prompt "UART config uart BUS0 rx pin."
        default 20
        depends on DRIVER_SUPPORT_UART && (UART_BUS_MAX_NUM > 0)

    config UART_BUS0_CTS_PIN
        int
        prompt "UART config uart BUS0 cts pin, which is not used by default."
        default 100
        depends on UART_SUPPORT_FLOW_CTRL && (UART_BUS_MAX_NUM > 0)

    config UART_BUS0_RTS_PIN
        int
        prompt "UART config uart BUS0 rts pin, which is not used by default."
        default 100
        depends on UART_SUPPORT_FLOW_CTRL && (UART_BUS_MAX_NUM > 0)

    config UART_BUS1_TX_PIN
        int
        prompt "UART config uart BUS1 tx pin."
        default 17
        depends on DRIVER_SUPPORT_UART && (UART_BUS_MAX_NUM > 1)

    config UART_BUS1_RX_PIN
        int
        prompt "UART config uart BUS1 rx pin."
        default 18
        depends on DRIVER_SUPPORT_UART && (UART_BUS_MAX_NUM > 1)

    config UART_BUS1_CTS_PIN
        int
        prompt "UART config uart BUS1 cts pin, which is not used by default."
        default 100
        depends on UART_SUPPORT_FLOW_CTRL && (UART_BUS_MAX_NUM > 1)

    config UART_BUS1_RTS_PIN
        int
        prompt "UART config uart BUS1 rts pin, which is not used by default."
        default 100
        depends on UART_SUPPORT_FLOW_CTRL && (UART_BUS_MAX_NUM > 1)

    config UART_BUS2_TX_PIN
        int
        prompt "UART config uart BUS2 tx pin."
        default 15
        depends on DRIVER_SUPPORT_UART && (UART_BUS_MAX_NUM > 2)

    config UART_BUS2_RX_PIN
        int
        prompt "UART config uart BUS2 rx pin."
        default 16
        depends on DRIVER_SUPPORT_UART && (UART_BUS_MAX_NUM > 2)

    config UART_BUS2_CTS_PIN
        int
        prompt "UART config uart BUS2 cts pin, which is not used by default."
        default 100
        depends on UART_SUPPORT_FLOW_CTRL && (UART_BUS_MAX_NUM > 2)

    config UART_BUS2_RTS_PIN
        int
        prompt "UART config uart BUS2 rts pin, which is not used by default."
        default 100
        depends on UART_SUPPORT_FLOW_CTRL && (UART_BUS_MAX_NUM > 2)
endif

if !USE_CUSTOM_PIN_CONFIG
    config UART_L0_TX_PIN
        int
        prompt "UART config uart L0 tx pin."
        default 19
        depends on DRIVER_SUPPORT_UART

    config UART_L0_RX_PIN
        int
        prompt "UART config uart L0 rx pin."
        default 20
        depends on DRIVER_SUPPORT_UART

    config UART_L0_CTS_PIN
        int
        prompt "UART config uart L0 cts pin, which is not used by default."
        default 100
        depends on UART_SUPPORT_FLOW_CTRL

    config UART_L0_RTS_PIN
        int
        prompt "UART config uart L0 rts pin, which is not used by default."
        default 100
        depends on UART_SUPPORT_FLOW_CTRL

    config UART_H0_TX_PIN
        int
        prompt "UART config uart H0 tx pin."
        default 17
        depends on DRIVER_SUPPORT_UART

    config UART_H0_RX_PIN
        int
        prompt "UART config uart H0 rx pin."
        default 18
        depends on DRIVER_SUPPORT_UART

    config UART_H0_CTS_PIN
        int
        prompt "UART config uart H0 cts pin, which is not used by default."
        default 100
        depends on UART_SUPPORT_FLOW_CTRL

    config UART_H0_RTS_PIN
        int
        prompt "UART config uart H0 rts pin, which is not used by default."
        default 100
        depends on UART_SUPPORT_FLOW_CTRL

    config UART_L1_TX_PIN
        int
        prompt "UART config uart L1 tx pin."
        default 15
        depends on DRIVER_SUPPORT_UART

    config UART_L1_RX_PIN
        int
        prompt "UART config uart L1 rx pin."
        default 16
        depends on DRIVER_SUPPORT_UART

    config UART_L1_CTS_PIN
        int
        prompt "UART config uart L1 cts pin, which is not used by default."
        default 100
        depends on UART_SUPPORT_FLOW_CTRL

    config UART_L1_RTS_PIN
        int
        prompt "UART config uart L1 rts pin, which is not used by default."
        default 100
        depends on UART_SUPPORT_FLOW_CTRL
endif

