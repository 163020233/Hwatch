config UART_BAUD_RATE_DIV_8
    bool
    prompt "UART Baud rate div 8."
    default y
    depends on DRIVER_SUPPORT_UART

config UART_SUPPORT_TX
    bool
    prompt "UART support TX."
    default y
    depends on DRIVER_SUPPORT_UART

config SUPPORT_UART_TX_POLL_TIMEOUT
    bool
    prompt "support timeout in uart TX poll mode."
    default n
    depends on UART_SUPPORT_TX

config UART_SUPPORT_TX_INT
    bool
    prompt "UART support TX interrupt mode."
    default y
    depends on DRIVER_SUPPORT_UART

config UART_SUPPORT_RX
    bool
    prompt "UART support RX."
    default y
    depends on DRIVER_SUPPORT_UART

