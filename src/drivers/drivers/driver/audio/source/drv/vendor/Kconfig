menu "Audio Vendor Driver Config"

config VENDOR_DRIVER_SUPPORT
    bool "Vendor Driver Support"
    default y          if BRANDY
    default n

if VENDOR_DRIVER_SUPPORT
###########################################################
menu "ANC CODEC Driver"

config VENDOR_DRIVER_ANC_CODEC_SUPPORT
    bool "ANC CODEC support"
    default n

if VENDOR_DRIVER_ANC_CODEC_SUPPORT

config CONTROL_ANC_CODEC_IN_ACORE
    bool "control anc codec via A core"
    default y

config CONTROL_ANC_CODEC_IN_DSP
    bool "control anc codec via DSP"
    default n

config ANC_CODEC_I2C_BUS_ID
    int "anc codec i2c bus id"
    default 0

config ANC_CODEC_I2C_ADDR
    hex "anc codec i2c address"
    default 0x28

endif

endmenu ## "ANC CODEC Driver"

