menu "Audio Driver Config"

menu "Audio Proc Info Config"

config PROC_SUPPORT
    bool "Audio Proc Info support"
    default y

if PROC_SUPPORT
###########################################################
choice
    prompt "Proc Type"
    default PROC_TYPE_DUMMY

config PROC_TYPE_DUMMY
    bool "dummy"
    help
        set proc type to dummy

config PROC_TYPE_REAL
    bool "real"
    help
        set proc type to real
endchoice

###########################################################
config PROC_OUTPUT_UART
    bool "enable proc uart output"
    default y
    depends on PROC_TYPE_DUMMY
    help
        enable proc output to uart

config PROC_OUTPUT_DIAG_SHELL
    bool "enable proc diag shell output"
    default n
    depends on PROC_TYPE_DUMMY
    help
        enable proc output to diag shell
###########################################################
config SYNC_STATUS_SUPPORT
    bool "show sync status in proc"
    default y

endif # PROC_SUPPORT
endmenu ## "Audio Proc Info Config"
###########################################################
menu "Audio Log Config"

