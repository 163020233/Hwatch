    bool "DSP ipc log diag frame support"
    default y          if SW21 || 3322

config IPC_LOG_WITHOUT_HEADER
    bool "DSP ipc log without header support"
    default n

config DIAG_LOG_SUPPORT
    bool "APP Core Diag log support"
    default y          if BRANDY || SOCMN1 || SOCMN2

endmenu ## "Audio Log Config"
