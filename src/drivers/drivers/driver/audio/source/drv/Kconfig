###########################################################
menu "Audio DSP Firmware Config"
config FLASH_FIRMWARE_SUPPORT
    bool "flash firmware support"
    default n

config DSP_OVERLAY_SUPPORT
    bool "DSP Overlay Support"
    default y

choice
    prompt "Overlay Location"
    default DRV_OVERLAY_LOAD_FROM_FLASH
    depends on DSP_OVERLAY_SUPPORT

config DRV_OVERLAY_LOAD_FROM_FLASH
    bool "flash"
    help
        load overlay from flash

config DRV_OVERLAY_LOAD_FROM_FILE
    bool "file system"
    help
        load overlay from file system
endchoice

config DRV_OVERLAY_LOAD_FROM
    string
    default "flash"          if DRV_OVERLAY_LOAD_FROM_FLASH
    default "file"           if DRV_OVERLAY_LOAD_FROM_FILE

config FLASH_PARTITION_SUPPORT
    bool "Get firmware flash addr by partition interface"
    default n
###########################################################
config SIGN_SUPPORT
    bool "Audio Firmware Sign support"
    default n

if SIGN_SUPPORT
config SIGN_CHECK_ONLY_SUPPORT
    bool "Audio Firmware Check Sign Only support"
    default y          if SOCMN2
    default n

choice
    prompt "Sign Type"
    default SIGN_TYPE_CBG  if SW21
    default SIGN_TYPE_CFBB if SOCMN2

config SIGN_TYPE_CBG
    bool "cbg"
config SIGN_TYPE_CFBB
    bool "cfbb"
endchoice

config SIGN_TYPE
    string
    default "cbg"          if SIGN_TYPE_CBG
    default "cfbb"         if SIGN_TYPE_CFBB

config SIGN_HEADER_LEN
    hex "bin header signed info length(Bytes)"
    default 0x300

endif # SIGN_SUPPORT
###########################################################
endmenu ## "Audio DSP Firmware Config"
