config EFUSE_USING_V151
    bool
    prompt "Using EFUSE V151"
    default y
    depends on DRIVER_SUPPORT_EFUSE

config EFUSE_SWITCH_EN
    bool
    prompt "Using EFUSE SWITCH EN"
    default n
    depends on DRIVER_SUPPORT_EFUSE

config EFUSE_REGION_NUM
    int
    prompt "Max REGION of the EFUSE"
    range 1 3
    default 1
    depends on EFUSE_USING_V151

config EFUSE_READ_TO_RAM
    bool
    prompt "Using EFUSE READ TO RAM"
    default n
    depends on DRIVER_SUPPORT_EFUSE

config EFUSE_POWER_ON
    bool
    prompt "Using EFUSE POWER ON"
    default n
    depends on DRIVER_SUPPORT_EFUSE

config EFUSE_CONFIG_VOL
    bool
    prompt "Using EFUSE CONFIG VOL"
    default n
    depends on DRIVER_SUPPORT_EFUSE