config ADC_USING_V151
    bool
    prompt "Using adc V151."
    default n
    depends on DRIVER_SUPPORT_ADC

config ADC_USING_V152
    bool
    prompt "Using adc V152."
    default y
    depends on DRIVER_SUPPORT_ADC

config ADC_USING_V153
    bool
    prompt "Using adc V153."
    default n
    depends on DRIVER_SUPPORT_ADC

config ADC_USING_V154
    bool
    prompt "Using adc V154."
    default n
    depends on DRIVER_SUPPORT_ADC

config ADC_USING_V155
    bool
    prompt "Using adc V155."
    default n
    depends on DRIVER_SUPPORT_ADC

config ADC_USING_V156
    bool
    prompt "Using adc V156."
    default n
    depends on DRIVER_SUPPORT_ADC

config ADC_USING_V157
    bool
    prompt "Using adc V157."
    default n
    depends on DRIVER_SUPPORT_ADC

config ADC_SUPPORT_AFE
    bool
    prompt "ADC use Analog front-end mode."
    default y
    depends on (ADC_USING_V152 || ADC_USING_V153 || ADC_USING_V157)

config ADC_SUPPORT_DIFFERENTIAL
    bool
    prompt "ADC support differential sample."
    default y
    depends on (ADC_USING_V153 || ADC_USING_V157)

config ADC_SUPPORT_AMIC
    bool
    prompt "Whether ADC support AMIC."
    default y
    depends on ADC_USING_V153

config ADC_SUPPORT_HAFE
    bool
    prompt "Whether ADC support HAFE."
    default y
    depends on ADC_USING_V152

config AFE_SAMPLE_TIMES
    int
    prompt "The numbers ADC sample to average."
    default 4
    depends on ADC_USING_V152

config ADC_SUPPORT_DIFFERENTIAL_SAMPLE
    bool
    prompt "ADC support differential sample for AFE."
    default y
    depends on (ADC_SUPPORT_DIFFERENTIAL && ADC_USING_V157)