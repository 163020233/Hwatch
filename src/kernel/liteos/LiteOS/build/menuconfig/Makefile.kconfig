.PHONY += menuconfig savemenuconfig
.PHONY += defconfig allyesconfig allnoconfig

menuconfig:
	python3  $(RTOSLITETOPDIR)/build/menuconfig/usr_config.py

savemenuconfig:
	python3  $(RTOSLITETOPDIR)/build/menuconfig/usr_config.py savemenuconfig

defconfig:
	python3  $(RTOSLITETOPDIR)/build/menuconfig/usr_config.py defconfig

allyesconfig:
	python3  $(RTOSLITETOPDIR)/build/menuconfig/usr_config.py allyesconfig

allnoconfig:
	python3  $(RTOSLITETOPDIR)/build/menuconfig/usr_config.py allnoconfig
