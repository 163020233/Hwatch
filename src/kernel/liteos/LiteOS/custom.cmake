if(${CHIP} STREQUAL "3322")
    if("XTS_SUPPORT" IN_LIST DEFINES)
        if("CFG_DRIVERS_SPINOR" IN_LIST DEFINES)
            set(LITEOS_SRC_CONFIG ${LITEOSTOPDIR}/tools/build/config/${CHIP}_single_norflash_xts.config)
        elseif("CONFIG_DITING_XTS" IN_LIST DEFINES)
            set(LITEOS_SRC_CONFIG "${LITEOSTOPDIR}/tools/build/config/${CHIP}_diting_xts.config")
        else()
            set(LITEOS_SRC_CONFIG "${LITEOSTOPDIR}/tools/build/config/${CHIP}_xts.config")
        endif()
    elseif("CONFIG_FPGA_NOT_SUPPORT_PSRAM" IN_LIST DEFINES)
        set(LITEOS_SRC_CONFIG ${LITEOSTOPDIR}/tools/build/config/${CHIP}_no_psram.config)
    elseif("CFG_DRIVERS_SPINOR" IN_LIST DEFINES)
        set(LITEOS_SRC_CONFIG ${LITEOSTOPDIR}/tools/build/config/${CHIP}_single_norflash.config)
    elseif("BUILD_APPLICATION_TEST_SUITE_CMSIS" IN_LIST DEFINES)
        set(LITEOS_SRC_CONFIG ${LITEOSTOPDIR}/tools/build/config/${CHIP}.config)
    elseif("CFG_DRIVERS_NANDFLASH" IN_LIST DEFINES)
        set(LITEOS_SRC_CONFIG ${LITEOSTOPDIR}/tools/build/config/${CHIP}_nandflash.config)
    elseif("CFG_DRIVERS_MMC" IN_LIST DEFINES)
        set(LITEOS_SRC_CONFIG ${LITEOSTOPDIR}/tools/build/config/${CHIP}_emmc.config)
    else()
        set(LITEOS_SRC_CONFIG ${LITEOSTOPDIR}/tools/build/config/${CHIP}.config)
    endif()
endif()

