if(${CHIP} STREQUAL "socmn2")
    if(NOT "MEMORY_MINI" IN_LIST DEFINES)
        if(NOT DEFINED LITEOS_KCONFIG)
            set(LITEOS_SRC_CONFIG ${LITEOS_TOP_DIR}/self_src/tools/build/config/hi3372_app_common.config)
            set(MENUCSCRIPT ${LITEOS_TOP_DIR}/self_src/targets/hi3372_app/new_menuconfig.py)
            if("XTS_SUPPORT" IN_LIST DEFINES)
                execute_process(COMMAND ${Python3_EXECUTABLE} ${MENUCSCRIPT} ${ROOT_DIR}
                    ${LITEOS_SRC_CONFIG} ${DEFINES} "LITEOS_XTS_CONFIG=${LITEOS_XTS_CONFIG}")
            else()
                execute_process(COMMAND ${Python3_EXECUTABLE} ${MENUCSCRIPT} ${ROOT_DIR}
                    ${LITEOS_SRC_CONFIG} ${DEFINES})
            endif()

            if(("MELODY_DEMO_BMIC_RX" IN_LIST DEFINES) OR (("MELODY_DEMO_EARPHONE" IN_LIST DEFINES) OR ("MELODY_DEMO_BMIC_TX" IN_LIST DEFINES))
                OR ("MELODY_DEMO_SOUND_BOX" IN_LIST DEFINES) OR ("MELODY_DEMO_DONGLE" IN_LIST DEFINES) OR ("MELODY_DEMO_HA" IN_LIST DEFINES)
                OR "MELODY_DEMO_SOUNDBAR" IN_LIST DEFINES)
                set(LITEOS_SRC_CONFIG ${CMAKE_BINARY_DIR}/socmn2_app.config)
            # socmn2-xts|socmn2-ohos used file system
            elseif(("SOCMN2_OHOS" IN_LIST DEFINES) OR ("TEST_SUITE" IN_LIST DEFINES) OR ("STD_RECOVERY" IN_LIST DEFINES))
                set(LITEOS_SRC_CONFIG ${LITEOS_TOP_DIR}/self_src/tools/build/config/hi3372_app_std.config)
            # socmn2-xts close file system cache for open more file
            elseif("SOCMN2_XTS" IN_LIST DEFINES)
                set(LITEOS_SRC_CONFIG ${LITEOS_TOP_DIR}/self_src/tools/build/config/hi3372_app_xts.config)
            else()
                set(LITEOS_SRC_CONFIG ${LITEOS_TOP_DIR}/self_src/tools/build/config/hi3372_app_std.config)
            endif()
        endif()
    endif()
endif()

