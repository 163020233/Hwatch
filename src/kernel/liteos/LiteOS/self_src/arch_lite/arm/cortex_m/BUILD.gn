import("../../../../build/gn/config.gni")

kernel_module("cortex_m") {
    include_dirs = [
        "$LITEOSTOPDIR/kernel_lite/extended/dynload/include",
    ]

    if (defined(LOSCFG_PERF_HW_PMU)) {
        include_dirs += [
            "$LITEOSTOPDIR/kernel_lite/extended/perf"
        ]
    }

    sources = [
        "src/cache.c",
        "src/canary.c",
        "src/cpu.c",
        "src/dynload.c",
        "src/fault.c",
        "src/fpb.c",
        "src/intermit.S",
        "src/mpu.c",
        "src/pmu.c",
        "src/task.c",
        "src/dispatch.S",
        "src/exception.S",
        "$LITEOSTOPDIR/arch_lite/arm/common/thumb_backtrace.c"
    ]
    if (!defined(LOSCFG_KERNEL_LOWPOWER)) {
        sources -= ["src/intermit.S"]
    }
    if (!defined(LOSCFG_FPB_ENABLE)) {
        sources -= ["src/fpb.c"]
    }
    if (!defined(LOSCFG_APC_ENABLE)) {
        sources -= ["src/mpu.c"]
    }
    if (!defined(LOSCFG_PERF_HW_PMU)) {
        sources -= ["src/pmu.c"]
    }
}

config("public") {

}