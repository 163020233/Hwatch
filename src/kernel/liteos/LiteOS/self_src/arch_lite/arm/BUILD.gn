import("../../../build/gn/config.gni")

group("arm") {
  if (defined(LOSCFG_ARCH_ARM_CORTEX_M)) {
    deps = [ "cortex_m:cortex_m" ]
  } else {
    deps = [ "cortex_a_r:cortex_a_r" ]
  }
}

config("public") {
  if (defined(LOSCFG_ARCH_ARM_CORTEX_M)) {
    configs = [ "cortex_m:public" ]
  } else {
    configs = [ "cortex_a_r:public" ]
  }
}
