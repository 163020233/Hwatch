import("../../../build/gn/config.gni")

if (!defined(LOSCFG_SAFETY_KERNEL)) {
    kernel_module("drivers_base") {
        sources = [
            "src/los_device.c",
            "src/los_driver_pm.c",
            "src/los_driver.c"
        ]

        configs += [
            ":private",
        ]
    }
} else {
    static_library("libdriverbase") {
        import("../../../build/gn/libstatic.gni")
        configs += [
            "$RTOSLITETOPDIR/build/gn:modules_public",
            "$RTOSLITETOPDIR/build/gn:liteos_config",
        ]
        cflags = [
            "--include",
            "$LITEOS_MENUCONFIG_H",
        ]
        cflags_cc = cflags
        asmflags = cflags

        sources = [
            "src/los_device.c",
            "src/los_driver_pm.c",
            "src/los_driver.c"
        ]

        include_dirs = LITEOS_GN_KSTATIC_INCLUDE
        configs += [
            ":private",
        ]
    }
}

config("private") {
    include_dirs = [
        "$LITEOSTOPDIR/drivers/base/include"
    ]
}