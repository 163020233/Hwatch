config LOSCFG_DRIVERS_USB_UAC_INTERVAL
    int "Polling Interval of Data Transfer Endpoint"
    range 1 4 if LOSCFG_DRIVERS_USB_UAC_GADGET_VER_1_0
    range 1 3 if LOSCFG_DRIVERS_USB_UAC_GADGET_VER_2_0
    default 4 if LOSCFG_DRIVERS_USB_UAC_GADGET_VER_1_0
    default 3 if LOSCFG_DRIVERS_USB_UAC_GADGET_VER_2_0
    depends on LOSCFG_DRIVERS_USB_UAC_GADGET_VER_1_0 || LOSCFG_DRIVERS_USB_UAC_GADGET_VER_2_0
    help
      This indicates the polling interval of data transfer endpoint, and would be set as 4 in UAC 1.0 or 3 in UAC 2.0.
      Note, the value of uac2.0 must be set less than or equal to 3, because it may support 8 channels.

endmenu

