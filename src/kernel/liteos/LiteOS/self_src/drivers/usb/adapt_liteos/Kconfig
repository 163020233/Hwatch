    help
      Enable the connection status notification function of the USB virtual serial.
      If this function is disabled, some hosts, such as Windows 7, have compatibility problems.

config LOSCFG_DRIVERS_USB_ECM_GADGET
    bool "Enable USB ECM Gadget"
    depends on LOSCFG_DRIVERS_USB_GADGET && LOSCFG_COMPAT_LINUX

config LOSCFG_DRIVERS_USB_ETHERNET_GADGET
    bool "Enable USB Ethernet Class Gadget"
    depends on LOSCFG_DRIVERS_USB_GADGET && LOSCFG_COMPAT_LINUX

config LOSCFG_DRIVERS_USB_ETHERNET_CUSTOMIZED_NET_STACK
    bool "Enable Customized Network Protocol Stack"
    default n
    depends on (LOSCFG_DRIVERS_USB_ETHERNET_GADGET || LOSCFG_DRIVERS_USB_ETH_SER_GADGET \
                || LOSCFG_DRIVERS_USB_ECM_GADGET || LOSCFG_DRIVERS_USB_ECM_SER_GADGET)
    help
      Enabled when the user-defined network protocol stack is used.
      If the value is n, the network protocol stack uses lwip by default.

config LOSCFG_DRIVERS_USB_ETH_SER_GADGET
    bool "Enable USB Ethernet & Serial Gadget"
    depends on LOSCFG_DRIVERS_USB_GADGET
    help
      If this configuration is enabled, a network port or serial port occupies the 1out and 2in endpoints.
      The number of serial ports needs to be configured based on the actual number of endpoints.
      If the actual number of endpoints is exceeded, the loading fails.

config LOSCFG_DRIVERS_USB_ECM_SER_GADGET
    bool "Enable USB ECM & Serial Gadget"
    depends on LOSCFG_DRIVERS_USB_GADGET
    help
      If this configuration is enabled, a network port or serial port occupies the 1out and 2in endpoints.
      The number of serial ports needs to be configured based on the actual number of endpoints.
      If the actual number of endpoints is exceeded, the loading fails.

config LOSCFG_DRIVERS_USB_HID_GADGET
    bool "Enable USB HID Class Gadget"
    depends on LOSCFG_DRIVERS_USB_GADGET

choice
    prompt "HID Interface"
    depends on LOSCFG_DRIVERS_USB_HID_GADGET || LOSCFG_DRIVERS_USB_UAC_HID_GADGET
    default LOSCFG_DRIVERS_USB_HID_VFS_INTERFACE
    help
      This selects the type of HID interface.

config LOSCFG_DRIVERS_USB_HID_VFS_INTERFACE
    bool "Enable HID VFS Interface"
    depends on LOSCFG_FS_VFS
    help
      Use the VFS interface, but only one HID report can be set.

config LOSCFG_DRIVERS_USB_HID_FUNC_INTERFACE
    bool "Enable HID External Interface"
    help
      Use the function interface, up to two HID reports can be set.

config LOSCFG_DRIVERS_USB_HID_REPORT_MAP_NUM
    int "HID Report Map Num"
    default 2
    depends on LOSCFG_DRIVERS_USB_HID_FUNC_INTERFACE
    help
      Configure the number of HID report maps.

config LOSCFG_DRIVERS_USB_HID_POLLING_REPORTS
    bool "Enable HID Polling Reports"
    default n
    depends on LOSCFG_DRIVERS_USB2_DEVICE_CONTROLLER && LOSCFG_DRIVERS_USB_HID_FUNC_INTERFACE
    help
      Use USB SOF interrupt to send HID data.

endchoice

config LOSCFG_DRIVERS_USB_HID_INPUT_REPORT_LEN
    int "HID Input Report Length"
    default 12
    depends on LOSCFG_DRIVERS_USB_HID_GADGET || LOSCFG_DRIVERS_USB_UAC_HID_GADGET
    help
      Maximum length of the sent HID report.
      If the memory is a non-cache attribute, this value must be aligned by 4 bytes.
      If the memory is a cache attribute, this value must be aligned by USB_CACHE_ALIGN_SIZE.

config LOSCFG_DRIVERS_USB_HID_IN_DATA_SIZE
    int "HID In Endpoint Data Size"
    range 64 1024
    default 64
    depends on LOSCFG_DRIVERS_USB_HID_GADGET || LOSCFG_DRIVERS_USB_UAC_HID_GADGET
    help
      This indicates MaxPacketSize of hid in endpoint.

config LOSCFG_DRIVERS_USB_HID_OUT_DATA_SIZE
    int "HID Out Endpoint Data Size"
    range 64 1024
    default 64
    depends on LOSCFG_DRIVERS_USB_HID_GADGET || LOSCFG_DRIVERS_USB_UAC_HID_GADGET
    help
      This indicates MaxPacketSize of hid out endpoint.

config LOSCFG_DRIVERS_USB_HID_OUTPUT_REPORT
    bool "Enable HID Output Report Transfer"
    default y
    depends on LOSCFG_DRIVERS_USB_HID_GADGET || LOSCFG_DRIVERS_USB_UAC_HID_GADGET
    help
      Set y to support SET_REPORT request, receive output report sent by host, such as keyboard lights.
      Set n if hid report table has no output report feature, such as mouse.

config LOSCFG_DRIVERS_USB_UAC_HID_GADGET
    bool "Enable USB UAC & HID Gadget"
    depends on LOSCFG_DRIVERS_USB_GADGET

config LOSCFG_DRIVERS_USB_UAC_HID_EXT_SER_FUNC
    bool "Enable Extra Serial Function"
    depends on LOSCFG_DRIVERS_USB_UAC_HID_GADGET
    help
      Set y to enable the serial port function. Currently, only one serial port is supported.
      On the 3372 platform, there are 2 extra restrictions:
      The number of HID report maps must be 1.
      The USB Serial Notification Message Function must be disabled
endmenu

