# Generated by LiteOS Kconfig Tool
#
# Compiler
#
LOSCFG_COMPILER_GNU_BINUTILS=y
LOSCFG_COMPILER_CLANG=y
LOSCFG_COMPILER_TOOLCHAIN_MUSL=y
# LOSCFG_COMPILER_RISCV_GCC_MUSL is not set
# LOSCFG_COMPILER_RISCV_GCC_UNKNOWN is not set
# LOSCFG_COMPILER_RISCV_CLANG_UNKNOWN is not set
LOSCFG_COMPILER_RISCV_CLANG_MUSL=y

#
# Compiler Options
#
LOSCFG_RISCV_COMPILER_OPTIONS_USER_DEFINED=""
LOSCFG_RISCV_COMPILER_OPTIONS_LDM_STM=y
LOSCFG_RISCV_COMPILER_OPTIONS_EMIT_LLI=y
# LOSCFG_RISCV_COMPILER_OPTIONS_LBU_SB is not set
# LOSCFG_RISCV_COMPILER_OPTIONS_LHU_SH is not set
# end of Compiler Options

# LOSCFG_COMPILER_OPTIMIZE_NONE is not set
LOSCFG_COMPILER_OPTIMIZE_SPEED=y
# LOSCFG_COMPILER_OPTIMIZE_SIZE is not set
# end of Compiler

#
# Targets
#
# LOSCFG_FAMILY_BVT is not set
# LOSCFG_FAMILY_DPT is not set
# LOSCFG_FAMILY_AIOT is not set
# LOSCFG_FAMILY_TEST is not set
# LOSCFG_FAMILY_SMC is not set
# LOSCFG_FAMILY_STB is not set
# LOSCFG_FAMILY_QEMU is not set
# LOSCFG_FAMILY_STM32 is not set
# LOSCFG_FAMILY_SECRET is not set
# LOSCFG_FAMILY_HQ is not set
# LOSCFG_FAMILY_ENERGY is not set
LOSCFG_FAMILY_SHC=y
# LOSCFG_FAMILY_ASCEND is not set
# LOSCFG_FAMILY_DATACOM is not set
LOSCFG_PLATFORM="hi1a72_app"
# LOSCFG_PLATFORM_HI5601_MCU is not set
# LOSCFG_PLATFORM_HIEX is not set
# LOSCFG_PLATFORM_HIEX_NES is not set
# LOSCFG_PLATFORM_HIEX_ES is not set
# LOSCFG_PLATFORM_SUQIN_APP is not set
# LOSCFG_PLATFORM_HI1162_APP is not set
# LOSCFG_PLATFORM_SUSHIK_APP is not set
# LOSCFG_PLATFORM_BS21 is not set
# LOSCFG_PLATFORM_HI1A71 is not set
# LOSCFG_PLATFORM_HI2131 is not set
# LOSCFG_PLATFORM_SW21_APP is not set
# LOSCFG_PLATFORM_HI3372_APP is not set
# LOSCFG_PLATFORM_SW21_APP_SE is not set
# LOSCFG_PLATFORM_SW22_APP is not set
# LOSCFG_PLATFORM_SW22_APP_SE is not set
# LOSCFG_PLATFORM_SW22_GNSS is not set
# LOSCFG_PLATFORM_MP18_BGLE is not set
# LOSCFG_PLATFORM_MP18_GNSS is not set
# LOSCFG_PLATFORM_HI2132_APP is not set
# LOSCFG_PLATFORM_HI2132_CCORE is not set
LOSCFG_PLATFORM_HI1A72_APP=y

#
# RTOS DT
#
# LOSCFG_DT_RTOS is not set
# end of RTOS DT

LOSCFG_USING_BOARD_LD=y
LOSCFG_USING_BOARD_RESET_VECTOR=y
LOSCFG_ARCH_FPU_ENABLE=y
LOSCFG_APC_ENABLE=y
# LOSCFG_TRIGGER_ENABLE is not set
# LOSCFG_EXC_RECOVER_ENABLE is not set
# LOSCFG_HARDWARE_STACK_CHECK_ENABLE is not set
LOSCFG_ARCH_PMU=y
LOSCFG_ARCH_RISCV32=y
LOSCFG_ARCH_RISCV_RV32IMC=y
LOSCFG_ARCH_RISCV_ISA_B0p92=y
LOSCFG_ARCH_RISCV_ISA_F=y
LOSCFG_LCMP_CUSTOM_INST16_EXTENSIONS=y
LOSCFG_LCMP_CUSTOM_INST16_SUB_EXTENSIONS=y
LOSCFG_LCMP_CUSTOM_INST32_EXTENSIONS=y
LOSCFG_ARCH_LINX_M=y
LOSCFG_ARCH_LINXCORE_170=y
LOSCFG_ARCH_RISCV_EPMP=y
# end of Targets

#
# Kernel
#
LOSCFG_KERNEL_MIN=y
# LOSCFG_WCFS_SCHEDULER is not set

#
# Basic Config
#
LOSCFG_SCHED=y
LOSCFG_SCHED_SQ=y

#
# Task
#
# LOSCFG_SHARED_STACK is not set
LOSCFG_TASK_JOINABLE=y
# LOSCFG_BASE_CORE_TIMESLICE is not set
# LOSCFG_OBSOLETE_API is not set
LOSCFG_BASE_CORE_TSK_MONITOR=y
# LOSCFG_TASK_STACK_STATIC_ALLOCATION is not set
LOSCFG_TASK_STACK_DYNAMIC_ALLOCATION=y
LOSCFG_BASE_CORE_TSK_LIMIT=15
LOSCFG_BASE_CORE_TSK_MIN_STACK_SIZE=2048
LOSCFG_BASE_CORE_TSK_DEFAULT_STACK_SIZE=3072
LOSCFG_BASE_CORE_TSK_WORK_QUEUE_STACK_SIZE=3072
LOSCFG_BASE_CORE_TSK_SWTMR_STACK_SIZE=2048
LOSCFG_BASE_CORE_TSK_IDLE_STACK_SIZE=2048
LOSCFG_BASE_CORE_TSK_DEFAULT_PRIO=10
LOSCFG_BASE_CORE_TICK_PER_SECOND=1000
# end of Task

# LOSCFG_BASE_CORE_USE_MULTI_LIST is not set
LOSCFG_BASE_CORE_USE_SINGLE_LIST=y
LOSCFG_STARTUP_STACK_SIZE=0x0
# end of Basic Config

#
# Memory Management
#
LOSCFG_KERNEL_MEM_ALLOC=y
LOSCFG_KERNEL_MEM_BESTFIT=y
# LOSCFG_KERNEL_MEM_BESTFIT_LITTLE is not set
# LOSCFG_KERNEL_MEM_SLAB_EXTENTION is not set
LOSCFG_MEM_TASK_STAT=y
# LOSCFG_MEM_DFX_SHOW_CALLER_RA is not set
# LOSCFG_MEMFRAG_DFX_SHOW_INFO is not set
# LOSCFG_MEM_DFX_DOUBLE_FREE_CHECK is not set
# LOSCFG_MEM_MUL_MODULE is not set
# LOSCFG_MEM_MUL_POOL is not set
LOSCFG_MAX_POOL_NUM=8
# LOSCFG_KERNEL_MEMBOX is not set
# end of Memory Management

#
# Interrupt Management
#
LOSCFG_ARCH_INTERRUPT_TAKEOVER=y
# LOSCFG_ARCH_INTERRUPT_PREEMPTION is not set
# LOSCFG_HWI_PRE_POST_PROCESS is not set
LOSCFG_HWI_WITH_ARG=y
# LOSCFG_SHARED_IRQ is not set
# LOSCFG_IRQ_RESP_COUNT is not set
LOSCFG_HWI_BOTTOM_HALF=y
LOSCFG_HWI_BOTTOM_HALF_WORK_LIMIT=16
LOSCFG_IRQ_STACK_SIZE=0x800
LOSCFG_NMI_STACK_SIZE=0x800
LOSCFG_PLATFORM_HWI_LIMIT=96
LOSCFG_HWI_PRIO_LIMIT=7
# end of Interrupt Management

#
# Exception Management
#
LOSCFG_EXC_SIMPLE_INFO=y
LOSCFG_EXC_STACK_SIZE=0x800
# LOSCFG_SHELL_EXCINFO_DUMP is not set
# end of Exception Management

LOSCFG_BASE_CORE_SWTMR=y
LOSCFG_BASE_CORE_SWTMR_LIMIT=32
# LOSCFG_BASE_CORE_SWTMR_IN_ISR is not set
# LOSCFG_SWTMR_SYNC_DELETE is not set
LOSCFG_BASE_IPC_QUEUE=y
# LOSCFG_QUEUE_STATIC_ALLOCATION is not set
LOSCFG_QUEUE_DYNAMIC_ALLOCATION=y
LOSCFG_BASE_IPC_QUEUE_LIMIT=30
# LOSCFG_QUEUE_PEAK_STAT is not set
LOSCFG_BASE_IPC_EVENT=y
LOSCFG_BASE_IPC_MUX=y
LOSCFG_MUTEX_WAITMODE_PRIO=y
# LOSCFG_MUTEX_WAITMODE_FIFO is not set
LOSCFG_BASE_IPC_MUX_LIMIT=64
# LOSCFG_BASE_IPC_MUX_CREATOR is not set
LOSCFG_BASE_IPC_SEM=y
LOSCFG_BASE_IPC_SEM_LIMIT=30
LOSCFG_BASE_IPC_RWSEM=y
LOSCFG_BASE_IPC_RWSEM_LIMIT=1024
# LOSCFG_KERNEL_NX is not set
LOSCFG_KERNEL_PRINTF=y
LOSCFG_KERNEL_PRINTF_SIZE_EXTEND=y
LOSCFG_KERNEL_RINGBUF=y
# LOSCFG_KERNEL_CONSOLE is not set
# LOSCFG_KERNEL_EXTKERNEL is not set
LOSCFG_BASE_CORE_SYS_RES_CHECK=y
# LOSCFG_SHELL_COMMAND_TRIM is not set
# LOSCFG_TASK_CB_TRIM is not set
# end of Kernel

#
# Lib
#
LOSCFG_LIB_LIBSEC=y
LOSCFG_LIB_LIBC=y
# LOSCFG_LIB_LIBC_MEM_POOL is not set
# LOSCFG_LIB_LIBC_COMPAT_WIDTH64 is not set
LOSCFG_COMPAT_POSIX=y
# LOSCFG_COMPAT_POSIX_THREAD_LOCALE is not set
LOSCFG_LIB_VENDORNAME="vendor"
LOSCFG_LIB_LIBM=y
# LOSCFG_LIB_LIBMAT is not set
LOSCFG_LIB_FORMAT=y
# LOSCFG_LIBC_TRIM_TIME is not set
# LOSCFG_LIBC_TRIM_LOCALE is not set
LOSCFG_LIB_STDIO=y
# LOSCFG_LIBC_TRIM_REMOVE is not set
# LOSCFG_SUPPORT_LONG_DOUBLE is not set
# LOSCFG_LIB_ZLIB is not set
# end of Lib

#
# Compat
#
LOSCFG_COMPAT_CMSIS=y
# LOSCFG_COMPAT_CMSIS_VER_1 is not set
LOSCFG_COMPAT_CMSIS_VER_2=y
LOSCFG_COMPAT_LINUX=y
LOSCFG_COMPAT_LINUX_PENDLIST=y
LOSCFG_COMPAT_LINUX_TIMER=y
# LOSCFG_COMPAT_LINUX_HRTIMER is not set
LOSCFG_COMPAT_LINUX_IRQ=y
# LOSCFG_COMPAT_LINUX_SEMAPHORE is not set
# LOSCFG_COMPAT_LINUX_RW_SEMAPHORE is not set
# LOSCFG_COMPAT_LINUX_COMPLETION is not set
LOSCFG_COMPAT_LINUX_WAITQUEUE=y
LOSCFG_COMPAT_LINUX_WORKQUEUE=y
LOSCFG_COMPAT_LINUX_DRIVER_BASE=y
# LOSCFG_COMPAT_LINUX_WAKELOCK is not set
LOSCFG_COMPAT_LINUX_CHECKSUM=y
LOSCFG_COMPAT_LINUX_MODULE=y
LOSCFG_COMPAT_LINUX_CRC32=y
LOSCFG_COMPAT_LINUX_RBTREE=y
LOSCFG_COMPAT_LINUX_MTD_LIST=y
# LOSCFG_COMPAT_RT_THREAD is not set
# LOSCFG_COMPAT_FREERTOS is not set
# end of Compat

#
# FileSystem
#
LOSCFG_FS_COMPAT_NUTTX=y
LOSCFG_FS_VFS=y
# LOSCFG_FS_VFS_BLOCK_DEVICE is not set
LOSCFG_FS_FAT=y
LOSCFG_FS_FAT_CACHE=y
LOSCFG_FS_FAT_BLOCK_NUMS=32
# LOSCFG_FS_FAT_CACHE_SYNC_THREAD is not set
LOSCFG_FS_FAT_CACHE_PROC=y
# LOSCFG_FS_FAT_CACHE_INDEPENDENT_MEMORY_POOL is not set
# LOSCFG_FS_FAT_DCACHE is not set
# LOSCFG_FS_FAT_TRIM is not set
LOSCFG_FS_FAT_CHINESE=y
LOSCFG_FS_FAT_CHINESE_GB2312=y
# LOSCFG_FS_FAT_CHINESE_UTF_8 is not set
# LOSCFG_FS_FAT_VIRTUAL_PARTITION is not set
LOSCFG_FS_FAT_VOLUMES=16
# LOSCFG_FS_FAT_INDEPENDENT_MEMORY_POOL is not set
LOSCFG_FS_FAT_WRITE_WITH_SYNC=y
LOSCFG_FS_FAT_STACK_LFN=y
# LOSCFG_FS_FAT_HEAP_LFN is not set
LOSCFG_FS_RAMFS=y
# LOSCFG_FS_ROMFS is not set
LOSCFG_FS_PROC=y
# end of FileSystem

LOSCFG_DRIVER_DISK=y

#
# Debug
#
# LOSCFG_COMPILE_DEBUG is not set
LOSCFG_PLATFORM_ADAPT=y
# LOSCFG_BACKTRACE is not set
# LOSCFG_DEBUG_RESOURCE_INFO is not set
# LOSCFG_DEBUG_VERSION is not set
# LOSCFG_HWI_STACK_CHECK is not set
# LOSCFG_SYSTEM_VIEW is not set
# LOSCFG_DEBUG_MEM_MWMD is not set
# LOSCFG_SHELL_ADAPT_AT is not set
# LOSCFG_CMD_UNLOAD is not set
LOSCFG_SERIAL_OUTPUT_ENABLE=y
LOSCFG_APPINIT_TESTSUIT=y
LOSCFG_PLATFORM_OSAPPINIT=y
# LOSCFG_TEST is not set
# LOSCFG_LLTREPORT is not set
LOSCFG_KERNEL_LMS=y
LOSCFG_LMS_MAX_RECORD_POOL_NUM=10
LOSCFG_LMS_LOAD_CHECK=y
LOSCFG_LMS_STORE_CHECK=y
# LOSCFG_LMS_CHECK_STRICT is not set
LOSCFG_LMS_LIBC_HIGH_FREQ_FUNC_CHECK=y
# LOSCFG_LMS_LIBC_FULL_CHECK is not set
# end of Debug

#
# Driver
#
LOSCFG_DRIVERS_BASE=y
LOSCFG_RISCV_LCMP_CLIC=y
LOSCFG_TIMER_VENDOR=y
LOSCFG_DRIVERS_UART_VENDOR=y
# LOSCFG_DRIVERS_UART is not set
LOSCFG_DRIVERS_SIMPLE_UART=y
LOSCFG_DRIVERS_MMC=y
LOSCFG_DRIVERS_MMC_TASK_PRI=2
LOSCFG_DRIVERS_MMC_TASK_STACK_SIZE=0x2000
# LOSCFG_DRIVERS_MMC_CONTROLLER_SDHCI is not set
# LOSCFG_DRIVERS_MMC_CONTROLLER_SDMCI is not set
LOSCFG_DRIVERS_MMC_HISDEMMC=y
# LOSCFG_DRIVERS_SD is not set
LOSCFG_DRIVERS_EMMC=y
LOSCFG_DRIVERS_EMMC_HS200=y
# LOSCFG_DRIVERS_MMC_RPMB is not set
# LOSCFG_DRIVERS_MMC_EXT_CLK_SWITCH is not set
# LOSCFG_DRIVERS_MMC_DMA_CACHE_DISABLE is not set
LOSCFG_MMCSD_TASK_STACK_SIZE=3072
# LOSCFG_DRIVERS_MTD is not set
# LOSCFG_DRIVERS_USB is not set
# end of Driver

#
# Stack Smashing Protector (SSP) Compiler Feature
#
# LOSCFG_CC_NO_STACKPROTECTOR is not set
# LOSCFG_CC_STACKPROTECTOR is not set
LOSCFG_CC_STACKPROTECTOR_STRONG=y
# LOSCFG_CC_STACKPROTECTOR_ALL is not set
# end of Stack Smashing Protector (SSP) Compiler Feature
