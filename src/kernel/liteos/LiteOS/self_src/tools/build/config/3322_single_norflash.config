LOSCFG_DRIVERS_USB_COMPOSITE_GADGET=y
LOSCFG_DRIVERS_USE_VENDOR_HISI_CAMERA=y
LOSCFG_DRIVERS_VENDOR_PATH="vendor/hisi/camera/drivers"
