LOSCFG_DRIVERS_USB=y
LOSCFG_DRIVERS_USB_DWC_DRIVER=y
LOSCFG_DRIVERS_USB_SERIAL_GADGET_MULT=y
LOSCFG_DRIVERS_USB_SERIAL_COUNT=2

#
# USB DWC Controller Config
#
# LOSCFG_DRIVERS_USB2_DEVICE_CONTROLLER is not set
LOSCFG_DRIVERS_USB3_DEVICE_CONTROLLER=y
# LOSCFG_DRIVERS_USB3_DEVICE_USB_MODE_USB_1_1 is not set
