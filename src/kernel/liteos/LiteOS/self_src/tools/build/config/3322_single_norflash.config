LOSCFG_DRIVERS_USB_HID_IN_DATA_SIZE=64
LOSCFG_DRIVERS_USB_HID_OUT_DATA_SIZE=64
LOSCFG_DRIVERS_USB_HID_OUTPUT_REPORT=y
