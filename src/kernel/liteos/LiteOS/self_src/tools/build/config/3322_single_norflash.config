LOSCFG_DRIVERS_USB_DEVICE_SLAVE_CONFIG=y
LOSCFG_USB_OUT_EP_NUM=3
LOSCFG_USB_IN_EP_NUM=3
LOSCFG_USB_GEVENT_BUF_NUM=0
LOSCFG_USB_DEPCFG_INTR_NUM=0
LOSCFG_USB_DMA_OFFSET="0x0"


# end of USB DWC Controller Config

LOSCFG_DRIVERS_USB_GADGET=y

#
# USB Gadget Drivers
#
LOSCFG_DRIVERS_USB_MASS_STORAGE_GADGET=y
