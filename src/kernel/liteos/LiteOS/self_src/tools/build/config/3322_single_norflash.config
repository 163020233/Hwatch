# LOSCFG_FS_FAT_HEAP_LFN=y
# LOSCFG_DRIVERS_MMC_TASK_PRI=2
# LOSCFG_DRIVERS_MMC_TASK_STACK_SIZE=0x2000
LOSCFG_FS_PROC=y
# LOSCFG_DRIVERS_MMC_HISDEMMC=y
CONFIG_VFS_BIND_WITH_PATH=y
CONFIG_VFS_OPERATION_EXTEND=y
LOSCFG_FS_LITTLEFS=y
# end of FileSystem
LOSCFG_DRIVER_DISK=y
LOSCFG_PLATFORM_HI3322_APP=y
