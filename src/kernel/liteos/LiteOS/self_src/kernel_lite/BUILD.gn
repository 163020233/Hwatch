import("../../build/gn/config.gni")

group("kernel_lite") {
    deps = [
        "base:base",
        "init:init",
        "extended:extended",
    ]
}

config("public") {
    kernel_include = [
        "$LITEOSTOPDIR/kernel_lite/include",
        "$LITEOSTOPDIR/kernel_lite/base/include",
    ]

    ext_kernel_include = []
    if (defined(LOSCFG_KERNEL_EXTKERNEL)) {
        ext_kernel_include += ["$LITEOSTOPDIR/kernel_lite/extended/include"]
    }

    include_dirs = kernel_include + ext_kernel_include
}