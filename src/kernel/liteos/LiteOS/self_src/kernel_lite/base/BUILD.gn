import("../../../build/gn/config.gni")

kernel_module("base") {
    sources = []
    include_dirs = [
        "$LITEOSTOPDIR/kernel_lite/extended/include/lowpower",
        "$LITEOSTOPDIR/kernel_lite/extended/include",
        "$LITEOSTOPDIR/kernel_lite/base/mem",
    ]

    if (defined(LOSCFG_KERNEL_MIN)) {
        sources += [
            "los_bitmap.c",
            "los_err.c",
            "los_misc.c",
            "los_mp.c",
            "los_percpu.c",
            "los_sortlink.c",
            "los_stackinfo.c",
            "los_task.c",
            "los_tick.c",
            "los_exc.c",
        ]
    }

    if (defined(LOSCFG_ARCH_INTERRUPT_TAKEOVER)) {
        sources += [
            "los_hwi.c"
        ]
    }

    if (defined(LOSCFG_BASE_IPC_QUEUE)) {
        sources += [
            "los_queue.c"
        ]
    }

    if (defined(LOSCFG_BASE_IPC_EVENT)) {
        sources += [
            "los_event.c"
        ]
    }

    if (defined(LOSCFG_BASE_IPC_MUX)) {
        sources += [
            "los_mux.c"
        ]
    }

    if (defined(LOSCFG_BASE_IPC_SEM)) {
        sources += [
            "los_sem.c"
        ]
    }

    if (defined(LOSCFG_BASE_IPC_RWSEM)) {
        sources += [
            "los_rwsem.c"
        ]
    }

    if (defined(LOSCFG_BASE_CORE_SWTMR)) {
        sources += [
            "los_swtmr.c"
        ]
    }

    if (defined(LOSCFG_KERNEL_SPINDEP)) {
        sources += [
            "los_spinlock.c"
        ]
    }

    if (defined(LOSCFG_KERNEL_PRINTF)) {
        sources += [
            "los_printf.c"
        ]
    }

    if (defined(LOSCFG_KERNEL_RINGBUF)) {
        sources += [
            "los_ringbuf.c"
        ]
    }

    if (!(!defined(LOSCFG_DEBUG_TASK) && !defined(LOSCFG_SHELL) && defined(LOSCFG_EXC_SIMPLE_INFO))) {
        sources += [
            "debug/los_task_debug.c"
        ]
    }
    if (defined(LOSCFG_DEBUG_HWI)) {
        sources += [
            "debug/los_hwi_debug.c"
        ]
    }
    if (defined(LOSCFG_DEBUG_SWTMR)) {
        sources += [
            "debug/los_swtmr_debug.c"
        ]
    }
    if (defined(LOSCFG_DEBUG_QUEUE)) {
        sources += [
            "debug/los_queue_debug.c"
        ]
    }
    if (defined(LOSCFG_DEBUG_MUTEX)) {
        sources += [
            "debug/los_mux_debug.c"
        ]
    }
    if (defined(LOSCFG_DEBUG_SEMAPHORE)) {
        sources += [
            "debug/los_sem_debug.c"
        ]
    }
    if (defined(LOSCFG_DEBUG_SCHED_STATISTICS)) {
        sources += [
            "debug/los_sched_debug.c"
        ]
    }
    if (defined(LOSCFG_KERNEL_LOCKDEP)) {
        sources += [
            "debug/los_lockdep_debug.c"
        ]
    }
    if (defined(LOSCFG_PTHREAD_MUXDEP)) {
        sources += [
            "debug/pthread_mux_deadlock_debug.c"
        ]
    }
    if (defined(LOSCFG_SCHED_SQ)) {
        sources += [
            "sched/sched_sq/los_priqueue.c",
            "sched/sched_sq/los_sched.c"
        ]
    }
    if (defined(LOSCFG_SCHED_MQ)) {
        sources += [
            "sched/sched_mq/los_sched.c"
        ]
    }
    if (defined(LOSCFG_KERNEL_MEM_BESTFIT)) {
        sources += [
            "mem/bestfit/los_multipledlinkhead.c",
            "mem/bestfit/los_memory.c",
        ]
    }
    if (defined(LOSCFG_KERNEL_MEM_BESTFIT_LITTLE)) {
        sources += [
            "mem/bestfit_little/los_heap.c",
            "mem/bestfit_little/los_memory.c"
        ]
    }
    if (defined(LOSCFG_KERNEL_MEM_SLAB_EXTENTION)) {
        sources += [
            "mem/slab/los_slab.c",
            "mem/slab/los_slabmem.c",
        ]
    }
    if (defined(LOSCFG_MEM_TASK_STAT)) {
        sources += [
            "mem/common/memstat/los_memstat.c"
        ]
    }
    if (defined(LOSCFG_KERNEL_MEMBOX_STATIC)) {
        sources += [
            "mem/membox/los_membox.c"
        ]
    }
    if (defined(LOSCFG_KERNEL_MEMBOX_DYNAMIC)) {
        sources += [
            "mem/membox/los_membox_dyn.c"
        ]
    }
    if (defined(LOSCFG_MEM_MUL_POOL)) {
        sources += [
            "mem/common/multipool/los_multipool.c"
        ]
    }
    if (defined(LOSCFG_SHELL)) {
        if (defined(LOSCFG_DEBUG_HWI)) {
            sources += [
                "shellcmd/hwi_shellcmd.c"
            ]
        }
        if (defined(LOSCFG_DEBUG_SWTMR)) {
            sources += [
                "shellcmd/swtmr_shellcmd.c"
            ]
        }
        if (defined(LOSCFG_LOWPOWER_SLEEP_DEBUG)) {
            sources += [
                "shellcmd/lpm_shellcmd.c"
            ]
        }
        sources += [
            "shellcmd/mempt_shellcmd.c",
            "shellcmd/sysinfo_shellcmd.c",
            "shellcmd/stack_shellcmd.c",
            "shellcmd/task_shellcmd.c"
        ]
    }
