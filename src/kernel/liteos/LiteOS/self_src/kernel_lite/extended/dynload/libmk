include $(RTOSLITETOPDIR)/config.mk

MODULE_NAME := $(notdir $(shell pwd))

OBJDIR = $(OUT)/obj/kernel/extended/dynload
SRCS = $(wildcard src/*.c)
COBJS = $(patsubst %.c,$(OBJDIR)/%.o,$(SRCS))

LOCAL_INCLUDE:= \
            -I $(LITEOSTOPDIR)/kernel_lite/extended/include \
            -I $(LITEOSTOPDIR)/kernel_lite/extended/dynload/include

all: $(COBJS)
	mkdir -p $(OUT)/lib
	cp -rf $(LITEOS_CPU_TYPE)/*.a $(OUT)/lib

$(COBJS): $(OBJDIR)/%.o : %.c
	mkdir -p $(OBJDIR)/src
	@$(CC) $(LITEOS_CFLAGS) $(LOCAL_INCLUDE) -c $< -o $@

.PHONY: all

include $(MODULE)
