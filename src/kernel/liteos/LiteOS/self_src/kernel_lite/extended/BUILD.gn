import("../../../build/gn/config.gni")

group("extended") {
    deps = []
    if (defined(LOSCFG_KERNEL_CPUP)) {
        deps += ["cpup"]
    }
    if (defined(LOSCFG_KERNEL_DYNLOAD)) {
        deps += ["dynload"]
    }
    if (defined(LOSCFG_KERNEL_SCATTER)) {
        deps += ["scatter"]
    }
    if (defined(LOSCFG_KERNEL_TRACE)) {
