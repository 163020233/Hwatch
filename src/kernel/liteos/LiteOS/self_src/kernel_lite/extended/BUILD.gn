    if (defined(LOSCFG_KERNEL_LMS)) {
        deps += ["lms"]
    }
    if (defined(LOSCFG_KERNEL_LOWPOWER)) {
        deps += ["lowpower"]
    }
    if (defined(LOSCFG_KERNEL_CPPSUPPORT)) {
        deps += ["cppsupport"]
    }
    if (defined(LOSCFG_KERNEL_DYNSHM)) {
        deps += ["dynshm"]
    }
    if (defined(LOSCFG_KERNEL_RPQUEUE)) {
        deps += ["rpqueue"]
    }
