import("../../../../build/gn/config.gni")

kernel_module("perf") {
    include_dirs = [
        "$LITEOSTOPDIR/kernel_lite/extended/include",
        "$LITEOSTOPDIR/kernel_lite/extended/perf",
    ]

    sources = [
        "los_perf.c",
        "perf_output.c",
        "perf_pmu.c",
    ]

    if (defined(LOSCFG_PERF_HW_PMU)) {
        sources += ["pmu/perf_hw_pmu.c"]
    }

    if (defined(LOSCFG_PERF_TIMED_PMU)) {
        sources += ["pmu/perf_timed_pmu.c"]
    }

    if (defined(LOSCFG_PERF_SW_PMU)) {
        sources += ["pmu/perf_sw_pmu.c"]
    }
}