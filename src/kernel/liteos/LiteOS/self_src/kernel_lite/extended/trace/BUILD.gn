import("../../../../build/gn/config.gni")

kernel_module("trace") {
    include_dirs = [
        "$LITEOSTOPDIR/kernel_lite/extended/include",
        "$LITEOSTOPDIR/kernel_lite/extended/trace/pipeline",
    ]

    if (defined(LOSCFG_TRACE_PIPELINE_SERIAL)) {
        include_dirs = [
            "$LITEOSTOPDIR/kernel_lite/extended/trace/pipeline/serial"
        ]
    }

    sources = [
        "los_trace.c",
        "trace_offline.c",
        "trace_online.c",
    ]

    if (defined(LOSCFG_TRACE_CLIENT_INTERACT)) {
        sources += [
            "pipeline/trace_pipeline.c",
            "pipeline/trace_tlv.c",
        ]
    }

    if (defined(LOSCFG_TRACE_PIPELINE_SERIAL)) {
        sources += [
            "pipeline/serial/trace_pipeline_serial.c",
        ]
    }
}