config LOSCFG_KERNEL_LMS
    bool "Enable Lite Memory Sanitizer"
    default n
    help
      Select y to build LiteOS with memory sanitizer.

config LOSCFG_LMS_MAX_RECORD_POOL_NUM
    int "Lms check pool max num"
    default 10
    depends on LOSCFG_KERNEL_LMS
    help
      The Max num of lms check pool

config LOSCFG_LMS_LOAD_CHECK
    bool "Enable lms read check"
    default y
    depends on LOSCFG_KERNEL_LMS
    help
      Select y to enable read check.

config LOSCFG_LMS_STORE_CHECK
    bool "Enable lms write check"
    default y
    depends on LOSCFG_KERNEL_LMS
    help
      Select y to enable write check.

config LOSCFG_LMS_CHECK_STRICT
    bool "Enable lms strict check, byte-by-byte"
    default n
    depends on LOSCFG_KERNEL_LMS
    help
      Select y to enable byte-by-byte check in lms

config LOSCFG_LMS_LIBC_HIGH_FREQ_FUNC_CHECK
   bool "Enable libc high frequency function check"
   default y
   depends on LOSCFG_LIB_LIBC && (LOSCFG_LMS_LOAD_CHECK || LOSCFG_LMS_STORE_CHECK)
   help
     Checks the memory when libc frequently-memory-accessed functions are called,
     including memset, memcpy, memmove, strcat, strcpy, strncat and strncpy.
     At least one of LOSCFG_LMS_LOAD_CHECK and LOSCFG_LMS_STORE_CHECK must be enabled.

config LOSCFG_LMS_LIBC_FULL_CHECK
   bool "Enable libc all function do lms check"
   default n
   depends on LOSCFG_LMS_LIBC_HIGH_FREQ_FUNC_CHECK
   help
     Select y to enable libc full check
