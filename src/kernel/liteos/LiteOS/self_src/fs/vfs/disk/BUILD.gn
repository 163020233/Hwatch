import("../../../../build/gn/config.gni")

if (!defined(LOSCFG_SAFETY_KERNEL)) {
    kernel_module("disk") {
        sources = [
            "disk_shellcmd.c",
            "disk.c",
        ]

        configs += [
            ":private",
        ]
    }
} else {
    static_library("libdisk") {
        import("../../../../build/gn/libstatic.gni")
        configs += [
            "$RTOSLITETOPDIR/build/gn:modules_public",
            "$RTOSLITETOPDIR/build/gn:liteos_config",
            "$LITEOSTOPDIR/arch_s/riscv:public",
            "$LITEOSTOPDIR/lib:public",
        ]
        cflags = [
            "--include",
            "$LITEOS_MENUCONFIG_H",
        ]
        cflags_cc = cflags
        asmflags = cflags

        sources = [
            "disk_shellcmd.c",
            "disk.c",
        ]

        include_dirs = LITEOS_GN_KSTATIC_INCLUDE
        configs += [
            ":private",
        ]

    }
}

config("private") {
    include_dirs = [
        "$LITEOSTOPDIR/drivers/mmc/core",
        "$LITEOSTOPDIR/fs/vfs/include/utrim",

    ]
    if (defined(LOSCFG_FS_FAT_FTL)) {
        include_dirs += [
            "$LITEOSTOPDIR/fs/vfs/include/ftl",
        ]
    }
}