{
	"requires": {
		"min_cli_version": "0.1.0",
		"toolchains": [
			{ "name": "bisheng", "version": "26.03.1" }
		]
	},
	"chipName": "3322",
	"seriesName": "cfbb",
	"board": "3322",
	"examples": {
		"roots": ["application/wearable/nativeapp/nativeui"]
	},
	"templates": {
		"dir": "tools/bin/fbb_tool/templates"
	},
	"compile": {
	  "custom_build_command": "pack_diting_community",
	  "tool_chain": [
		"cc_riscv32_musl_fp_win"
	  ],
	  "map_path": "./output/3322/acore/diting-community/application.map"
	},
	"debug": {
	  "elf_path": "./output/3322/acore/diting-community/application.elf",
	  "breakpoints_limitation": "3",
	  "stop_debug_state": "continue",
	  "client": [
		"gdb"
	  ],
	  "entry_point": "app_main",
	  "tool": [
		"jlink"
	  ],
	  "params": [
		{
		  "name": "jlink",
		  "param": {
			"interface": [
			  "swd",
			  "jtag"
			],
			"speed": "5000",
			"port": "3333"
		  }
		}
	  ],
	  "timeout_list": [
		"15000",
		"30000",
		"60000",
		"120000",
		"-1"
	  ],
	  "timeout_default": "60000"
	},
	"upload": {
	  "bin_path": "./output/3322/fwpkg/diting-community.fwpkg",
	  "reset": 1,
	  "burn_verification": 0,
	  "protocol": [
		"serial"
	  ],
	  "baudList": ["2400", "4800", "9600", "19200", "38400", "57600", "115200", "230400", "460800",
	  "500000", "750000", "921600", "2000000"],
	  "params": [
		{
		  "name": "serial",
		  "param": {
			"port": "",
			"baud": "750000",
			"stop_bit": "0",
			"parity": "N"
		  }
		}
	  ]
	},
	"gui": {
	  "appDir": "application/wearable/nativeapp",
	  "simulatorDir": "tools/simulator"
	},
	"monitor": {
		"default_baud": 115200,
		"reset_method": "none",
		"reset_command": ""
	},
	"flash": {
		"backend": "burntool",
		"chiptype": "Hi3322",
		"signalbaud": 750000,
		"expected_sections": 7
	},
	"need_sdk": true,
	"need_project_path": true,
	"chip_config": false,
  	"variabletrace": false,
	"platform": "cfbb",
	"project_type": [
	  {
		"name": "cfbb",
		"base_on_sdk": true
	  }
	],
	"analysis": {
		"elf_path": "./output/3322/acore/diting-community/application.elf",
		"map_path": "./output/3322/acore/diting-community/application.map",
		"tool_path": ".tools/bin/compiler/bisheng_26_03_1/BiSheng-llvm-15.0.4-riscv-x86-win-26.03.1/bin/riscv32"
	},
    "target": {
		"3322": {
			"pack_diting_community": {
				"cmake": {
					"build": {
						"build_argv": "pack_diting_community"
					},
					"stack analysis": {
						"analysis_compiler_path": "./tools/bin/compiler/bisheng_26_03_1/BiSheng-llvm-15.0.4-riscv-x86-win-26.03.1/bin/riscv32"
					},
					"image analysis": {
						"analysis_elf_path": "./output/3322/acore/diting-community/application.elf",
						"analysis_map_path": "./output/3322/acore/diting-community/application.map"
					},
					"upload": {
						"upload_partitions": "./output/3322/fwpkg/diting-community.fwpkg"
					},
					"chip config": {
						"board_build.mcu": "3322"
					}
				}
			},
