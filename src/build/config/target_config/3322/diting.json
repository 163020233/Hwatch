					},
					"image analysis": {
						"analysis_elf_path": "./output/3322/acore/diting-community-native-js/application.elf",
						"analysis_map_path": "./output/3322/acore/diting-community-native-js/application.map"
					},
					"upload": {
						"upload_partitions": "./output/3322/fwpkg/diting-community-native-js.fwpkg"
