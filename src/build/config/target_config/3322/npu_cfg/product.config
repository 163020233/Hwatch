export PROJECT=3322

export LIBRARY=static

export OPERATING_SYSTEM=liteos

export NPU_VERSION=V350R1

export KERNEL_RPATH=misc/prebuilts/drv/os/hi1139/vendor

export COMPILER_RPATH=../../tools/bin/compiler/bisheng_26_03_1/BiSheng-llvm-15.0.4-riscv-x86-linux-26.03.1/bin

export TOOLCHAINS=llvm

export CPU_TYPE=riscv

export COMPILE_FLAGS="-march=rv32imfdcb0p92xlinxma_xlinxmb_xlinxmc_xlinxmd -mabi=ilp32d \
    -DTARGET_CHIP_3322=1 \
    -D__LITEOS__ \
    -DDUMP_THREAD_SET_RT_TASK \
    -DLOSCFG_WCFS_SCHEDULER \
    -DSAP_SHELL_SUPPORT -DCONFIG_NPU_LIB \
    -ftrapv -ffunction-sections -fdata-sections \
    -D_FORTIFY_SOURCE=2 -O2 \
    -mllvm -enable-ldst-multiple-opt=true -mllvm -enable-global-merge=false -mllvm -riscv-enable-copyelim=true \
    -mllvm -enable-machine-outliner=always -mllvm -m-push-pop=true -mllvm -enable-sequence-abstract=true \
    -mllvm -disable-shrink-to-bool=true -mllvm --jump-is-expensive=false -mllvm --min-jump-table-entries=1000000 \
    -mllvm -enable-lwgp=true -mllvm -machine-outliner-funcbytes=4 \
    -mllvm -enable-branch-imm-no-zero=true -mllvm -enable-lli=false \
    -mllvm -enable-rodata-sections=true -mllvm -allow-unalign-ldst=true -mllvm -disable-indexed-ldst=false"

export SECUREC_RDIR=../../middleware/utils/hwsec_c/include

export SECUREC_C_RDIR=../../middleware/utils/hwsec_c/src

export TEST_NPU_RPATH=../../../protocol/npu/npu_nano

export NPU_TURING_RPATH=../../../protocol/npu/turing/C11

export BUILD_RPATH=build/${PROJECT}/npu

export OUTPUT_RPATH=../../interim_binary/3322/libs/npu

export CMAKE_RPATH=../../build/config/target_config/3322/npu_cfg/headfile.cmake

export TURING_CMAKE_RPATH=../../build/config/target_config/3322/npu_cfg/liteos_headers.cmake

# SHELL特性
export SHELL_USED=y

# 环境LIB库中包含GETOPT
export LIB_HAS_GETOPT=y

# avl特性
export FLASH_SEARCH_TYPE=avl

# emmc
export FILESYSTEM_TYPE=native

# 低功耗
export LOW_POWER_FEATURE=y

# chr打点日志特性
export CHR_LOG_PRINT=y

# NPU执行时切频
export FREQ_DYNAMIC_CHANGE=y