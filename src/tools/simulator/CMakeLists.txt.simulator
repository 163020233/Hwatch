    "-L${BIN_ROOT_DIR}/uikit/lib"
    "${BIN_ROOT_DIR}/vau/BLOCK_HTC.dll" "${BIN_ROOT_DIR}/vau/gpu_rm.dll"
    "-L${BIN_ROOT_DIR}/SDL2/lib/x64"
    ${LINK_LIBS})
