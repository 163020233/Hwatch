# 子项目cmakelist使用的宏，需要重写实现
macro(build_component)
    set(SIMULATOR_PUBLIC_HEADER ${SIMULATOR_PUBLIC_HEADER} ${PUBLIC_HEADER} CACHE INTERNAL "")
    set(SIMULATOR_PRIVATE_HEADER ${SIMULATOR_PRIVATE_HEADER} ${PRIVATE_HEADER} CACHE INTERNAL "")
    set(SIMULATOR_APPLICATION_SOURCES ${SIMULATOR_APPLICATION_SOURCES} ${SOURCES} CACHE INTERNAL "")
endmacro()
macro(add_subdirectory_if_exist dir)
    if(NOT ${dir} STREQUAL "sample")
        add_subdirectory(${dir})
    endif()
endmacro()
macro(return_if_not_build)
endmacro()
macro(install_sdk)
endmacro()
macro(install_sdk_by_sh)
endmacro()

find_package(Python3 REQUIRED COMPONENTS Interpreter)
if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
    find_package(Git)
    if(Git_FOUND)
        get_filename_component(GIT_INSTALL_DIR "${GIT_EXECUTABLE}" DIRECTORY)
        get_filename_component(PATCH_EXE ${GIT_INSTALL_DIR}/../usr/bin/patch.exe ABSOLUTE) 
    else()
        message(STATUS "本地未找到git工具")
        set(PATCH_EXE patch)
    endif()
else()
    set(PATCH_EXE patch)
endif()

function(run_install_script py_script gen_dir source_dir)
    # 创建标记文件路径
    get_filename_component(archive_name "${source_dir}" NAME)
    set(flag_file "${SIMULATOR_BUILD_DIR}/.${archive_name}.extracted")
    if(EXISTS "${flag_file}" AND EXISTS "${source_dir}")
        return()
    endif()

    # 设置安装命令
    set(INSTALL_CMD
        ${Python3_EXECUTABLE}
        ${py_script}
        --gen-dir
        ${gen_dir}
        --source-dir
        ${source_dir}
        --patch-dir
        ${PATCH_EXE}
    )
    
    string(JOIN " " INSTALL_STR ${INSTALL_CMD})
    message(STATUS "INSTALL = ${INSTALL_STR}")
    
    execute_process(
        COMMAND ${INSTALL_CMD}
        OUTPUT_VARIABLE output
        RESULT_VARIABLE result
        ERROR_VARIABLE error_output
    )
     # 创建标记文件
    string(TIMESTAMP BUILD_TIME "%Y-%m-%d %H:%M:%S")
    if(result EQUAL 0)
        message(STATUS "✅ 补丁解压成功==>${source_dir}")
        file(WRITE "${flag_file}" "Extracted on: ${BUILD_TIME}")
    else()
        message(STATUS "❌ 补丁解压失败==>${source_dir}")
        message(STATUS "err: ${output}")
    endif()
endfunction()

