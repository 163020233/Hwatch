        ${SIMULATOR_BUILD_DIR}/gen/third_party/freetype/freetype/src/base/ftbbox.c
        ${SIMULATOR_BUILD_DIR}/gen/third_party/freetype/freetype/src/base/ftbitmap.c
        ${SIMULATOR_BUILD_DIR}/gen/third_party/freetype/freetype/src/base/ftdebug.c
        ${SIMULATOR_BUILD_DIR}/gen/third_party/freetype/freetype/src/base/ftglyph.c
        ${SIMULATOR_BUILD_DIR}/gen/third_party/freetype/freetype/src/base/ftinit.c
        ${SIMULATOR_BUILD_DIR}/gen/third_party/freetype/freetype/src/base/ftsystem.c
        ${SIMULATOR_BUILD_DIR}/gen/third_party/freetype/freetype/src/gzip/ftgzip.c
        ${SIMULATOR_BUILD_DIR}/gen/third_party/freetype/freetype/src/sfnt/sfnt.c
        ${SIMULATOR_BUILD_DIR}/gen/third_party/freetype/freetype/src/smooth/smooth.c
        ${SIMULATOR_BUILD_DIR}/gen/third_party/freetype/freetype/src/truetype/truetype.c
    )
    add_library("freetype_static" STATIC ${FREETYPE_SOURCES})
    set_target_properties("freetype_static" PROPERTIES LINKER_LANGUAGE C
                        COMPILE_DEFINITIONS "FT_CONFIG_OPTION_SYSTEM_ZLIB"
                        OUTPUT_NAME "freetype"
                        ARCHIVE_OUTPUT_DIRECTORY ${FREETYPE_LIB_PATH})
endif()

if (BUILD_UIKIT)
set(SIMULATOR_SOURCES
    ${CLOSED_SRC}
)

# 设置目标名称
set(TARGET_NAME uikit)
# 生成静态文件
set(TARGET_NAME_STATIC "${TARGET_NAME}-static")
add_library(${TARGET_NAME_STATIC} STATIC ${SIMULATOR_SOURCES})
TARGET_LINK_LIBRARIES(${TARGET_NAME_STATIC} "-L${BIN_ROOT_DIR}/vau/lib" "-L${BIN_ROOT_DIR}/SDL2/lib/x64" "-L${FREETYPE_LIB_PATH}" ${LINK_LIBS})
set_target_properties(${TARGET_NAME_STATIC} PROPERTIES LINKER_LANGUAGE C
                      OUTPUT_NAME ${TARGET_NAME}
                      ARCHIVE_OUTPUT_DIRECTORY ${SIMULATOR_DIR}/uikit/lib)
endif() # BUILD_UIKIT


