                   ${BIN_ROOT_DIR}/vau/gpu_rm.dll ${SIMULATOR_DIR}/bin)

add_custom_command(TARGET watch POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy
                   ${BIN_ROOT_DIR}/vau/BLOCK_HTC.dll ${SIMULATOR_DIR}/bin)
