<div class="container" style="flex-direction: column;">
    <list class="todo-wrapper">
        <list-item class="todo-item" style="background-color: rebeccapurple;" on:click="getMtu">
            <text class="todo-title">getMtu</text>
        </list-item>
        <list-item class="todo-item" style="background-color: steelblue;" on:click="getDeviceMtu">
            <text class="todo-title">getDeviceMtu</text>
        </list-item>
        <list-item class="todo-item" style="background-color: rebeccapurple;" on:click="startBLEScanWithOnBLEDeviceFind">
            <text class="todo-title">开始扫描</text>
        </list-item>
        <list-item class="todo-item" style="background-color: steelblue;" on:click="stopBLEScan">
            <text class="todo-title">停止扫描</text>
        </list-item>
        <list-item class="todo-item" style="background-color: rebeccapurple;" on:click="connectWithDeviceId">
            <text class="todo-title">connectWithDeviceId</text>
        </list-item>
        <list-item class="todo-item" style="background-color: rebeccapurple;" on:click="connectWithoutDeviceId">
            <text class="todo-title">connectWithoutDeviceId</text>
        </list-item>
        <list-item class="todo-item" style="background-color: rebeccapurple;" on:click="disconnectWithDeviceId">
            <text class="todo-title">disconnectWithDeviceId</text>
        </list-item>
        <list-item class="todo-item" style="background-color: rebeccapurple;" on:click="disconnectWithoutDeviceId">
            <text class="todo-title">disconnectWithoutDeviceId</text>
        </list-item>
        <list-item class="todo-item" style="background-color: rebeccapurple;" on:click="close">
            <text class="todo-title">close</text>
        </list-item>
        <list-item class="todo-item" style="background-color: rebeccapurple;" on:click="getDeviceNameAndRssiValueWithDeviceId">
