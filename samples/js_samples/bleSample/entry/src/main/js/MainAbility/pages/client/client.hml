        </list-item>
        <list-item class="todo-item" style="background-color: rebeccapurple;" on:click="getServicesWithDeviceId">
            <text class="todo-title">getServicesWithDeviceId</text>
        </list-item>
        <list-item class="todo-item" style="background-color: rebeccapurple;" on:click="getServicesWithoutDeviceId">
            <text class="todo-title">getServicesWithoutDeviceId</text>
        </list-item>
        <list-item class="todo-item" style="background-color: rebeccapurple;" on:click="writeCharacteristicValueWriteLoop">
