        </list-item>
        <list-item class="todo-item" style="background-color: rebeccapurple;" on:click="writeCharacteristicValueWriteNoResponseWithDeviceId">
            <text class="todo-title">writeCharacteristicValueWriteNoResponseWithDeviceId</text>
        </list-item>
