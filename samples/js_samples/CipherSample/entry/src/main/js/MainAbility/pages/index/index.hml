<div class="container" onswipe="onback">
    <list style="width: 80%;height: 70%;background-color: white;">
        <list-item style="width: 100%;height: 100px;" for="{{list}}">
            <text style="width: 100%; height: 100%;margin-top: 10px;margin-left: 10%;
                    margin-right: 10% ;margin-bottom: 10px;background-color: green;"
                  onclick="click($item)">{{$item}}</text>
        </list-item>
    </list>
</div>
