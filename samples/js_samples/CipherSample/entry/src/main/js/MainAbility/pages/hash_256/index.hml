<div class="container" onswipe="exit">
    <div style="width: 100%; height: 60px; background-color: white;justify-content: center; align-items: center;">
        <input type="button" style="width: 200px; height: 60px; background-color: green;" onclick="all_hash">all hash</input>
        <input type="button" style="width: 200px; height: 60px; background-color: green;" onclick="sub_hash">sub hash</input>
    </div>
    <text style="width: 70%; height: 60%; background-color: gray;" >{{text}}</text>
</div>
