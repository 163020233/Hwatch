<div class="container" style="flex-direction: column;">
    <div class="header"
         style="flex-direction: column; align-items: center; justify-content: center; padding-bottom: 10px;">
        <text class="title">Socket通信测试</text>
        <text style="color: #faad14; font-size: 26px; font-weight: bold; margin-top: 5px;">{{ displayInfo }}</text>
    </div>

    <list class="todo-wrapper">

        <list-item class="section-header">
            <text class="section-title">实例切换面板</text>
        </list-item>

        <list-item style="width: 100%; height: 80px; flex-direction: row; justify-content: space-between;
                margin-bottom: 15px;">
            <div style="width: 48%; height: 100%; background-color: #722ed1; border-radius: 40px;
                    justify-content: center; align-items: center;" on:click="switchPrev">
                <text style="color: white; font-size: 28px; font-weight: bold;">&lt; 上一个</text>
            </div>
            <div style="width: 48%; height: 100%; background-color: #722ed1; border-radius: 40px;
                    justify-content: center; align-items: center;" on:click="switchNext">
                <text style="color: white; font-size: 28px; font-weight: bold;">下一个 &gt;</text>
            </div>
        </list-item>

        <list-item class="section-header">
            <text class="section-title">创建与基础演示</text>
        </list-item>

        <list-item class="todo-item" style="background-color: #007dff;" on:click="runTCPDemo">
            <text class="todo-title">新建 TCP 通信</text>
        </list-item>
        <list-item class="todo-item" style="background-color: #007dff;" on:click="runUDPDemo">
            <text class="todo-title">新建 UDP 通信</text>
        </list-item>
        <list-item class="todo-item" style="background-color: #007dff;" on:click="runErrorHandlingDemo">
            <text class="todo-title">错误处理演示</text>
        </list-item>
        <list-item class="todo-item" style="background-color: #007dff;" on:click="runHTTPClientDemo">
            <text class="todo-title">HTTP客户端演示</text>
        </list-item>

        <list-item class="section-header">
            <text class="section-title">操作当前实例：消息发送</text>
        </list-item>

        <list-item class="todo-item" style="background-color: #52c41a;" on:click="sendAnotherMessage">
            <text class="todo-title">发送单条消息</text>
        </list-item>
        <list-item class="todo-item" style="background-color: #52c41a;" on:click="sendBinaryData">
            <text class="todo-title">发送二进制数据</text>
        </list-item>
        <list-item class="todo-item" style="background-color: #52c41a;" on:click="testSendMultipleMessages">
            <text class="todo-title">批量发送消息</text>
        </list-item>
        <list-item class="todo-item" style="background-color: #52c41a;" on:click="runStressTest">
            <text class="todo-title">压力测试</text>
        </list-item>
        <list-item class="todo-item" style="background-color: #52c41a;" on:click="runTenMinRandomStressTest">
            <text class="todo-title">10分钟马拉松压测</text>
        </list-item>

        <list-item class="todo-item" style="background-color: #ff0c7300;" on:click="runMultiConcurrentStressTest">
            <text class="todo-title">10分钟多并发测试</text>
        </list-item>

        <list-item class="section-header">
            <text class="section-title">操作当前实例：接收控制</text>
        </list-item>

        <list-item class="todo-item" style="background-color: #fa8c16;" on:click="stopReceiving">
            <text class="todo-title">停止接收</text>
        </list-item>
        <list-item class="todo-item" style="background-color: #fa8c16;" on:click="restartReceiving">
            <text class="todo-title">重新开始接收</text>
        </list-item>

        <list-item class="section-header">
            <text class="section-title">操作当前实例：状态管理</text>
        </list-item>

        <list-item class="todo-item" style="background-color: #722ed1;" on:click="showConnectionStatus">
            <text class="todo-title">查看连接状态</text>
        </list-item>
        <list-item class="todo-item" style="background-color: #722ed1;" on:click="closeCurrentSocket">
            <text class="todo-title">关闭当前连接</text>
        </list-item>
        <list-item class="todo-item" style="background-color: #faad14;" on:click="destroySocketClient">
            <text class="todo-title">销毁客户端</text>
        </list-item>
        <list-item style="height: 100px; width: 100%; background-color: transparent;"></list-item>
    </list>
</div>